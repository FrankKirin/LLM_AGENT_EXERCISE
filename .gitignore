# ------------------ 1. Python 编译缓存（必须忽略） ------------------
__pycache__/
*.py[cod]
*.so
*.pyd

# ------------------ 2. 虚拟环境（必须忽略） ------------------
venv/
.venv/
env/
ENV/
virtualenv/

# ------------------ 3. 包管理器与构建产物 ------------------
# pip 的临时构建文件
build/
dist/
*.egg-info/
*.egg

# Poetry 和 Pipenv 锁文件建议保留（不在这里忽略），但下载目录忽略
.pip_cache/
.poetry_cache/

# ------------------ 4. IDE 和编辑器配置（按需忽略） ------------------
.vscode/
.idea/
*.iml

# ------------------ 5. 环境变量与敏感信息（必须忽略！）------------------
.env
.secrets
*.pem
*.key

# ------------------ 6. 测试与覆盖率 ------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ------------------ 7. 日志与数据库文件 ------------------
*.log
*.db
*.sqlite3

# ------------------ 8. 操作系统生成的垃圾文件 ------------------
.DS_Store
Thumbs.db